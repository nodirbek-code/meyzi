# Nusxa oling:  cp .env.example .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker'da web konteyner buni o'zi db:5432 ga almashtiradi.
# Lokal ishga tushirishda (venv) Postgres localhost'da bo'lishi kerak:
DATABASE_URL=postgres://meyzi:meyzi@localhost:5432/meyzi

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Telegram bildirishnomalari (faqat adminlar) ---
# 1) @BotFather da bot yarating va tokenni yozing
# 2) Botga /start yuboring, so'ng: docker compose exec web python manage.py telegram_chat_ids
# 3) Chiqqan chat ID(lar)ni vergul bilan yozing
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
MEYZI_SITE_URL=http://localhost:8000

# --- Telegram bot orqali ro'yxatdan o'tish / kirish (shu bot) ---
# Bot username'i (@ siz). Bo'sh bo'lsa — saytdagi "Telegram orqali kirish" tugmasi o'chiq.
# Botni ishga tushirish (dev): python manage.py telegram_bot
TELEGRAM_BOT_USERNAME=
# Bot yuboradigan "saytga kirish" havolasi shu manzilga olib boradi
MEYZI_FRONTEND_URL=http://localhost:3000
# Faqat prod (webhook) uchun: tasodifiy uzun satr
TELEGRAM_WEBHOOK_SECRET=

# --- Telefon tasdiqlash kodlari (Telegram Gateway) ---
# console — kod `docker compose logs web` da ko'rinadi; haqiqiy yuborish: gateway + token
TELEGRAM_CODE_BACKEND=console
TELEGRAM_GATEWAY_TOKEN=

# --- Google orqali kirish (Google Cloud Console → OAuth client ID, Web application) ---
GOOGLE_CLIENT_ID=
