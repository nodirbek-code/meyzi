# Nusxa: cp .env.prod.example .env.prod  — va qiymatlarni to'ldiring. .env.prod git'ga tushmaydi.
DJANGO_SECRET_KEY=uzun-tasodifiy-satr-kamida-50-belgi
DJANGO_ALLOWED_HOSTS=meyzi.uz
CSRF_TRUSTED_ORIGINS=https://meyzi.uz
CORS_ALLOWED_ORIGINS=https://meyzi.uz
DJANGO_SECURE_SSL_REDIRECT=True

POSTGRES_DB=meyzi
POSTGRES_USER=meyzi
POSTGRES_PASSWORD=kuchli-parol

# Email (SMTP): smtp+tls://login:parol@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=MEYZI <no-reply@meyzi.uz>
SMS_BACKEND=console

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
MEYZI_SITE_URL=https://meyzi.uz
# Telegram bot orqali kirish: webhook — python manage.py telegram_bot --set-webhook https://meyzi.uz/api/v1/auth/telegram/webhook/
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
MEYZI_FRONTEND_URL=https://meyzi.uz
# Sayt manzili (frontend ham, API ham shu domen orqali — nginx yo'naltiradi)
PUBLIC_URL=https://meyzi.uz

SENTRY_DSN=
GUNICORN_WORKERS=3
NGINX_PORT=80

# Telefon kodlari Telegram orqali: https://gateway.telegram.org (API token)
TELEGRAM_CODE_BACKEND=gateway
TELEGRAM_GATEWAY_TOKEN=
# Google orqali kirish: OAuth client ID (Authorized JavaScript origins: https://meyzi.uz)
GOOGLE_CLIENT_ID=
